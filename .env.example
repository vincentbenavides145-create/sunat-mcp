# RUC del titular de las credenciales emitidas por SUNAT.
SUNAT_RUC=

# Credenciales de API SUNAT registradas en SOL para Consulta de Validez de CPE.
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=

# Tiempo máximo de espera por solicitud a SUNAT (milisegundos).
SUNAT_TIMEOUT_MS=15000

# Híbrido: CDP para la web, UI Automation para login y controles nativos.
# uia conserva el modo anterior, que puede activar Brave.
SUNAT_BROWSER_MODE=hybrid
SUNAT_CDP_ENDPOINT=http://127.0.0.1:9222

# Espacio local de bóveda y trabajos. No sustituye una cuenta Windows separada.
# default conserva las rutas existentes; otros IDs: letras minúsculas, números, _ y -.
SUNAT_OPERATOR_ID=default
