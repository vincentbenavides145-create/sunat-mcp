{
  "name": "sunat-peru-mcp",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentbenavides145-create/sunat-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vincentbenavides145-create/sunat-mcp/issues"
  },
  "os": [
    "win32"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "MCP local para Windows para navegar SUNAT con Brave nativo y consultar servicios oficiales.",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sunat:importar-cuentas": "tsx src/import-accounts.ts",
    "sunat:catalogo-guias": "tsx scripts/build-official-guides.ts",
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public-files.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@microsoft/winappcli": "^0.7.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
